# ── DeepSeek / LLM ──
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Embedding ──
# provider: openai_compatible | local_bge | dummy
# dummy 仅用于跑通链路，会返回假向量，不要用于真实检索
EMBEDDING_PROVIDER=dummy
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# ── Milvus ──
MILVUS_DB_PATH=./milvus_interview.db